<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree -->
    <record id="view_printer_device_tree" model="ir.ui.view">
        <field name="name">printer.device.tree</field>
        <field name="model">printer.device</field>
        <field name="arch" type="xml">
            <list string="Impresoras" decoration-muted="not is_active" decoration-danger="status == 'error'" decoration-success="status == 'online'">
                <field name="name"/>
                <field name="location_id"/>
                <field name="partner_id"/>
                <field name="ip_address"/>
                <field name="model"/>
                <field name="manufacturer"/>
                <field name="status"/>
                <field name="total_pages"/>
                <field name="active_alerts_count" decoration-danger="active_alerts_count > 0"/>
                <field name="last_reading"/>
                <field name="is_active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_printer_device_kanban" model="ir.ui.view">
        <field name="name">printer.device.kanban</field>
        <field name="model">printer.device</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="location_id"/>
                <field name="partner_id"/>
                <field name="ip_address"/>
                <field name="model"/>
                <field name="manufacturer"/>
                <field name="status"/>
                <field name="is_active"/>
                <field name="total_pages"/>
                <field name="mono_pages"/>
                <field name="color_pages"/>
                <field name="active_alerts_count"/>
                <field name="last_reading"/>
                <field name="last_seen"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="object" name="action_view_readings" class="dropdown-item">Ver Lecturas</a>
                        <a role="menuitem" type="object" name="action_view_consumables" class="dropdown-item">Ver Consumibles</a>
                        <a role="menuitem" type="object" name="action_view_alerts" class="dropdown-item">Ver Alertas</a>
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Editar</a></t>
                    </t>
                    <t t-name="card">
                        <main t-att-class="record.status.raw_value == 'error' ? 'border-start border-danger border-3 ps-2' : (record.status.raw_value == 'offline' ? 'border-start border-secondary border-3 ps-2' : '')">
                            <field name="name" class="fw-bold"/>
                            <div class="text-muted">
                                <i class="oi" data-icon="location_on" title="Ubicación"/> <field name="location_id"/>
                            </div>
                            <div class="mt-1">
                                <!-- Status Badge -->
                                <span t-if="record.status.raw_value == 'online'" class="badge text-bg-success">
                                    <i class="oi oi-filled" data-icon="circle" title="En línea"/> En Línea
                                </span>
                                <span t-elif="record.status.raw_value == 'offline'" class="badge text-bg-secondary">
                                    <i class="oi" data-icon="radio_button_unchecked" title="Fuera de línea"/> Fuera de Línea
                                </span>
                                <span t-elif="record.status.raw_value == 'error'" class="badge text-bg-danger">
                                    <i class="oi" data-icon="error" title="Error"/> Error
                                </span>
                                <span t-elif="record.status.raw_value == 'maintenance'" class="badge text-bg-warning">
                                    <i class="oi" data-icon="build" title="Mantenimiento"/> Mantenimiento
                                </span>
                                <span t-else="" class="badge text-bg-secondary">
                                    <i class="oi" data-icon="help" title="Desconocido"/> Desconocido
                                </span>

                                <!-- Alert Badge -->
                                <span t-if="record.active_alerts_count.raw_value &gt; 0" class="badge text-bg-danger ms-2">
                                    <i class="oi" data-icon="notifications" title="Alertas"/> <field name="active_alerts_count"/> alertas
                                </span>
                            </div>
                            <div class="text-muted mt-2">
                                <i class="oi" data-icon="print" title="Impresoras"/> <field name="model"/> - <field name="manufacturer"/>
                            </div>
                            <div class="text-muted">
                                <i class="oi" data-icon="power" title="IP"/> <field name="ip_address"/>
                            </div>
                            <!-- Counters Section -->
                            <div class="mt-3" t-if="record.total_pages.raw_value > 0">
                                <strong>Contadores:</strong>
                                <div class="progress mt-1" style="height: 20px;">
                                    <div class="progress-bar bg-secondary" role="progressbar"
                                         t-att-style="'width: ' + (record.mono_pages.raw_value / record.total_pages.raw_value * 100) + '%'"
                                         t-att-aria-valuenow="record.mono_pages.raw_value"
                                         aria-valuemin="0"
                                         t-att-aria-valuemax="record.total_pages.raw_value">
                                        <small><field name="mono_pages"/> mono</small>
                                    </div>
                                    <div class="progress-bar bg-info" role="progressbar"
                                         t-att-style="'width: ' + (record.color_pages.raw_value / record.total_pages.raw_value * 100) + '%'"
                                         t-att-aria-valuenow="record.color_pages.raw_value"
                                         aria-valuemin="0"
                                         t-att-aria-valuemax="record.total_pages.raw_value">
                                        <small><field name="color_pages"/> color</small>
                                    </div>
                                </div>
                                <div class="text-center mt-1">
                                    <strong><field name="total_pages"/> páginas totales</strong>
                                </div>
                            </div>
                            <footer>
                                <div class="text-muted small">
                                    <i class="oi" data-icon="schedule" title="Fecha"/> Última lectura: <field name="last_reading"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_printer_device_form" model="ir.ui.view">
        <field name="name">printer.device.form</field>
        <field name="model">printer.device</field>
        <field name="arch" type="xml">
            <form string="Impresora">
                <header>
                    <button name="action_view_readings" string="Ver Lecturas" type="object" class="btn-primary"/>
                    <button name="action_view_consumables" string="Ver Consumibles" type="object"/>
                    <button name="action_view_alerts" string="Ver Alertas" type="object"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_readings" type="object" class="oe_stat_button" icon="show_chart">
                            <field name="total_pages" widget="statinfo" string="Total Páginas"/>
                        </button>
                        <button name="action_view_alerts" type="object" class="oe_stat_button" icon="warning">
                            <field name="active_alerts_count" widget="statinfo" string="Alertas Activas"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactiva" bg_color="text-bg-danger" invisible="is_active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la impresora..."/></h1>
                    </div>
                    <group>
                        <group name="main" string="Información Principal">
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="ip_address"/>
                            <field name="serial_number"/>
                            <field name="model"/>
                            <field name="manufacturer"/>
                            <field name="hostname"/>
                        </group>
                        <group name="status" string="Estado">
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="last_seen"/>
                            <field name="last_reading"/>
                            <field name="sync_status"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contadores" name="counters">
                            <group>
                                <group string="Páginas">
                                    <field name="total_pages"/>
                                    <field name="mono_pages"/>
                                    <field name="color_pages"/>
                                </group>
                                <group string="SNMP">
                                    <field name="community_string" password="True"/>
                                    <field name="snmp_version"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ubicación" name="location">
                            <group>
                                <field name="location"/>
                                <field name="department"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_printer_device_search" model="ir.ui.view">
        <field name="name">printer.device.search</field>
        <field name="model">printer.device</field>
        <field name="arch" type="xml">
            <search string="Buscar Impresoras">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="serial_number"/>
                <field name="location_id"/>
                <field name="partner_id"/>
                <filter string="Activas" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="En Línea" name="online" domain="[('status', '=', 'online')]"/>
                <group>
                    <filter string="Ubicación" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Fabricante" name="group_manufacturer" context="{'group_by': 'manufacturer'}"/>
                    <filter string="Estado" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_printer_device" model="ir.actions.act_window">
        <field name="name">Impresoras</field>
        <field name="res_model">printer.device</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay impresoras registradas
            </p>
            <p>
                Las impresoras se sincronizan automáticamente desde el PrintServer.
                Configure el PrintServer en cada ubicación con su token correspondiente.
            </p>
        </field>
    </record>

</odoo>
